# Repository-wide LaTeX audit: generated from scratch and committed by CI.
# The report contains text/JSON only; successful PDFs stay in workflow artifacts
# except for the curated docs/pdfs publication map.
!reports/latex_build/
!reports/latex_build/**
/build/latex-audit/

# Test/build caches anywhere in the tree
.pytest_cache/
# Lean/Lake build cache (dependencies are locked by formal/lean/lake-manifest.json)
formal/lean/.lake/
