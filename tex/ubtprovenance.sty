\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ubtprovenance}[2026/08/01 v1.1 UBT AI provenance and review profile]
\RequirePackage{xcolor}
\makeatletter
\def\UBT@tier{C}
\def\UBT@notice{AI-assisted working material; exhaustive human review is not claimed.}
\def\UBT@before{0.35em}
\def\UBT@after{0.65em}
\newif\ifUBT@reviewprofile
\UBT@reviewprofilefalse
\def\UBT@machine{not separately declared}
\def\UBT@human{not separately declared}
\def\UBT@editorial{not separately declared}
\newcommand{\UBTProvenanceTight}{\def\UBT@before{-1.25em}\def\UBT@after{-0.75em}}
\newif\ifUBT@noticeintitle
\UBT@noticeintitlefalse
\newcommand{\UBTProvenanceEmbedInTitle}{\UBT@noticeintitletrue}
\newcommand{\UBTProvenanceTitleLine}{%
  \parbox{0.88\textwidth}{\centering\scriptsize\color{black!78}%
    \textbf{AI provenance --- Tier \UBT@tier.} \UBT@notice\space
    Details: \texttt{AI\_PROVENANCE.md}.}%
}
\newcommand{\UBTReviewProfile}[3]{%
  \UBT@reviewprofiletrue
  \def\UBT@machine{#1}%
  \def\UBT@human{#2}%
  \def\UBT@editorial{#3}%
}
\newcommand{\UBTTier}[1]{%
  \def\UBT@tier{#1}%
  \def\UBT@A{A}\def\UBT@B{B}\def\UBT@C{C}%
  \ifx\UBT@tier\UBT@A
    \def\UBT@notice{AI-assisted; substantively reviewed by the author, who accepts editorial responsibility.}%
  \else\ifx\UBT@tier\UBT@B
    \def\UBT@notice{AI-assisted; machine-verified against named sources or verifiers; individual attestation is not claimed.}%
  \else\ifx\UBT@tier\UBT@C
    \def\UBT@notice{AI-assisted working material; exhaustive human review is not claimed.}%
  \else
    \PackageError{ubtprovenance}{Unknown provenance tier `#1'}{Use A, B, or C.}%
  \fi\fi\fi
}
\AtBeginDocument{%
  \@ifpackageloaded{hyperref}{%
    \hypersetup{%
      pdfsubject={Unified Biquaternion Theory; AI-assisted content; provenance tier \UBT@tier; machine verification: \UBT@machine; human review: \UBT@human; editorial approval: \UBT@editorial},%
      pdfkeywords={Unified Biquaternion Theory, AI provenance, AI-assisted research, provenance tier \UBT@tier, machine verification \UBT@machine, human review \UBT@human, editorial approval \UBT@editorial}%
    }%
  }{%
    \PackageWarningNoLine{ubtprovenance}{hyperref not loaded; PDF metadata was not injected}%
  }%
}
\newcommand{\UBTProvenanceNotice}{%
  \ifUBT@noticeintitle
  \else
    \par\vspace{\UBT@before}%
    \begingroup\scriptsize\noindent\color{black!78}%
    \textbf{AI provenance --- Tier \UBT@tier.} \UBT@notice\space
    Details: \texttt{AI\_PROVENANCE.md}.%
    \ifUBT@reviewprofile
      \par\smallskip
      \textbf{Review profile.} Machine verification: \UBT@machine;
      human review: \UBT@human; editorial approval: \UBT@editorial.\space
      Registry: \texttt{PROVENANCE\_REVIEW.yaml}.%
    \fi
    \par\vspace{\UBT@after}\endgroup
  \fi
}
\newcommand{\UBTFigureProvenance}[2]{%
  \par\begingroup\footnotesize\itshape
  Figure provenance: deterministic output of \texttt{#1} from \texttt{#2}; not AI-generated.
  \par\endgroup
}
\makeatother
\endinput
